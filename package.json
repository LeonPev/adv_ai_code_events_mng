{
  "name": "ccms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:db:setup": "DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy",
    "test:db:seed": "DATABASE_URL=$TEST_DATABASE_URL tsx prisma/seed.ts",
    "test:db:reset": "DATABASE_URL=$TEST_DATABASE_URL prisma migrate reset --force",
    "db:deploy": "prisma migrate deploy",
    "deploy": "bash scripts/manual-deploy.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^5.22.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "next": "14.2.35",
    "next-auth": "^4.24.14",
    "papaparse": "^5.5.3",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
